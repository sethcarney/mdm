# The build output of `make build`. Anchored to the repo root: an unanchored
# `mdm` also matches every directory named mdm, which silently swallowed
# src/mdm and test/mdm (the dev container feature and its tests).
/mdm
/mdm.exe
resource_windows.syso
.agents
.claude/*
!.claude/settings.json
.DS_Store

# MkDocs build output
/site
.venv

# `npm ci` output for the pinned devcontainer CLI (package.json is build
# tooling only; nothing in the mdm binary comes from npm).
/node_modules