{
  // Reproducible development environment for mdm.
  //
  // The Go version is deliberately NOT written here. The `go` directive in
  // go.mod is the single source of truth: post-create.sh reads it and pins
  // GOTOOLCHAIN to that exact version, so bumping go.mod is all it takes to
  // move the container. The feature below only provides a bootstrap Go.
  //
  // tests/devcontainer_test.go fails the build if any pin in this directory
  // drifts from go.mod or from the CI workflows.
  "name": "mdm",

  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    // Bootstrap Go — the exact build toolchain is pinned from go.mod in
    // post-create.sh, so this only needs to be new enough to run `go env -w`.
    // Also installs gopls and dlv, which .vscode/launch.json expects.
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    // mdm shells out to the git binary (internal/git) for clone/fetch, so git
    // has to be present for `mdm skills add` to work inside the container.
    // "os-provided" installs Debian's package instead of building from source.
    "ghcr.io/devcontainers/features/git:1": {
      "version": "os-provided"
    },
    // Claude Code CLI, plus the VS Code extension when opened in VS Code or
    // Codespaces. The :1.0 tag pins the feature's install script, not the CLI
    // release — the feature installs the latest Claude Code, which then
    // auto-updates itself inside the container.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Claude Code keeps its credentials, settings, and session history in
  // ~/.claude. The container home directory is discarded on rebuild, so without
  // this volume every rebuild means signing in again.
  //
  // A named volume rather than a bind mount: no host credential file is exposed
  // to the container. ${devcontainerId} scopes the volume to this project, so
  // mdm does not share a Claude Code session with every other repo on the
  // machine. The target must be the home directory of "remoteUser" below —
  // tests/devcontainer_test.go checks that they agree.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  // Pins GOTOOLCHAIN from go.mod, installs golangci-lint, govulncheck, and
  // goreleaser at their CI-pinned versions, then warms the module cache.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "off",
        "go.lintTool": "golangci-lint",
        "go.lintFlags": [
          "run"
        ],
        "gopls": {
          "formatting.gofumpt": false
        },
        "[go]": {
          "editor.formatOnSave": true
        }
      }
    }
  },

  "remoteUser": "vscode"
}
